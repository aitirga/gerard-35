# Copy to .env (git-ignored). `just backend` loads it automatically.
# Jev key from https://console.typesafe.ai/keys — without it battles use the built-in rule.
TYPESAFE_API_KEY=
# Optional: choose the battle provider ("jev", or "rules" to disable AI) and pin a Jev model.
# AI_BATTLE_PROVIDER=jev
# JEV_MODEL=jev-latest

# Asset tools (tools/, local only — never deployed).
# OpenAI key from https://platform.openai.com/api-keys — portraits and full-body art.
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# Anthropic key from https://platform.claude.com/settings/keys — Claude designs the 3D characters.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# Optional: Meshy key from https://www.meshy.ai/settings/api — only for --modeler meshy (GLB).
MESHY_API_KEY=
# Optional: Google Maps Platform key for `just geo-fetch` (Street View Static + Maps Static APIs).
# Pictures stay in output/geo/ as private references; without it the tool prints Google Maps links.
GOOGLE_MAPS_API_KEY=

# The lights at home (docs/home-lights.md). At home the server finds the bulbs on the LAN by itself
# (HOME_LIGHTS_LAN=0 turns that off); the LIFX Cloud token is the fallback, from
# https://cloud.lifx.com/settings. Without either the flat's lamps only work inside the game.
LIFX_TOKEN=
# Only for a deployed game (just deploy-lights): the key a browser must bring (?luces=<key>).
HOME_LIGHTS_KEY=
