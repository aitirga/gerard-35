# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Vite
.vite/

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Local env
.env
.env.*
!.env.example

# Claude Code local settings
.claude/settings.local.json

# Python and local persistent state
.venv/
__pycache__/
data/
# The ports `just dev` chose (scripts/dev-ports.sh)
.dev-ports

# Local browser verification artifacts
.playwright-cli/

# Scratch/generated outputs (approved artwork is copied into assets/ and public/), except the figures
# `just character-3d` makes (output/characters/3d/): the bestiary shows them on every machine.
output/*
!output/characters/
output/characters/*
!output/characters/3d/
output/characters/3d/**/*.log

# The artilugio's Wi-Fi and key (firmware/artilugio/secrets.example.h), and the binaries that carry them
firmware/**/secrets.h
firmware/**/build/

# Personal photos the game shows only on this machine (the credits' album): never committed, never deployed.
public/private/
