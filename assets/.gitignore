# Reference material is local by default: these are personal photos, and the
# repository (and the deployed site) is public. Delete these lines if you do
# want to track a particular kind of source asset in git.
*.png
*.jpg
*.jpeg
*.webp
*.heic
*.mp4
*.mov
*.glb
*.gltf
*.fbx
*.obj
*.blend
*.blend1
*.psd

# Song masters stay local; the game plays the copy `just music-export` puts in public/music/.
*.wav
*.aif
*.aiff
*.flac
*.mp3
*.m4a
*.ogg
*.opus

