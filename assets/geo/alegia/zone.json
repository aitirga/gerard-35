    { "id": "alegia-95", "label": "Mirar el portal del 95", "east_m": 0, "south_m": -6,
      "lines": ["San Juan kalea, 95. Soportales, geranios en los balcones y el río justo detrás.", "Aquí empieza la calle vieja de Alegia."] },
    { "id": "alegia-plaza", "label": "Mirar el plátano de la plaza", "east_m": -2, "south_m": -21,
      "lines": ["Un plátano podado en bola. Da sombra a media plaza Don Pio Montoya."] },
    { "id": "alegia-church", "label": "Mirar la iglesia de San Juan", "east_m": 78, "south_m": -44,
      "lines": ["La iglesia de San Juan: piedra gris, ventanas pequeñas y una torre de campanas que se ve desde todo el valle."] },
    { "id": "alegia-townhall", "label": "Mirar el ayuntamiento", "osm": "way/44884436",
      "lines": ["Alegiko udaletxea. Cuatro arcos abajo, un balcón de punta a punta y arriba el reloj con su campana.", "Encima de todo, el escudo del pueblo."] },
    { "id": "alegia-bridge", "label": "Asomarse al Oria", "osm": "way/508788821",
      "lines": ["Zubi Zaharra, el puente viejo. Una cruz de piedra mira el río desde el pilar.", "Abajo el Oria baja verde. Un poco más arriba ruge la presa."] },
    { "id": "alegia-presa", "label": "Escuchar la presa", "east_m": 136.9, "south_m": 5.6,
      "lines": ["La presa. El río salta por encima en una lámina blanca y no se calla nunca."] },
    { "id": "alegia-joare", "label": "Mirar el cencerro de piedra", "east_m": 188, "south_m": -12,
      "lines": ["Un cencerro enorme de piedra, tumbado sobre unas rocas.", "A los de Alegia los llaman txintxarris: aquí se hacían cencerros."] },
    { "id": "alegia-etxeak", "label": "Mirar los nombres de las casas", "east_m": 91.0, "south_m": -18.8,
      "lines": ["Cada casa lleva su nombre en un azulejo: Gorostiagaenea, Kafeteroenea, Konfiteroenea…", "Aquí las casas se llaman como la familia que vivía en ellas."] },
    { "id": "alegia-konfiteroenea", "label": "Mirar el escaparate de Konfiteroenea", "east_m": 126.1, "south_m": -25.9,
      "lines": ["Konfiteroenea, la casa del confitero. Abajo siguen vendiendo dulces.", "Huele a azúcar tostado desde media calle."] },
    { "id": "alegia-txokoa", "label": "Llamar a la puerta del txoko", "east_m": 141.2, "south_m": -30.0,
      "lines": ["Una puerta de madera con un azulejo: «Bazkideak bakarrik». Solo socios.", "Dentro alguien canta y chocan los vasos. No es mi txoko."] },
    { "id": "alegia-frontoia", "label": "Mirar el frontón", "east_m": 279.4, "south_m": -58.1,
      "lines": ["Un frontón pequeño para los críos, con su chapa abajo.", "Aquí todo el mundo juega a pelota desde que sabe andar."] },
    { "id": "alegia-bulebarra", "label": "Mirar Bulebarra", "east_m": 247.1, "south_m": 12.5,
      "lines": ["Bulebarra: un paseo sobre el río a la sombra de los plátanos."] },
    { "id": "alegia-toka", "label": "Mirar la toka", "east_m": 255.0, "south_m": 7.4,
