      "timeout": 60000
    },
    {
      "press": "Digit4"
    },
    {
      "press": "Enter",
      "gap": 400
    },
    {
      "until": "document.querySelector('#battle .turn-meta')?.textContent === 'TU TURNO'",
      "timeout": 60000
    },
    {
      "shot": "vertigo-eye",
      "delay": 800,
