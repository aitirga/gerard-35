{
  "title": "Nuria's mission · Cardedeu, Uri's maze and El Vértigo",
  "description": "docs/quests/nuria.md played through: out of the R4 at Cardedeu Haru waits at the station; Nuria at her door lends Haru and Yuki (Papagato, on trial) and the cats walk with the party; round the corner Uri's maze of hedges and garden walls, Uri ahead with Nil in his arms and violet eyes; El Cebollón jumps out of a bin, El Plato Misterioso and Game Over wait further in, El Vértigo on the roof; won, the three lights leave Nuria, Uri and Nil and go into Gerard and Aitor.",
  "steps": [
    {
      "open": "/?story=clue-r4&solo=1"
    },
    {
      "until": "document.title.startsWith('Meridiana') && !document.querySelector('#hud[data-dialogue]')",
      "timeout": 60000
    },
    {
      "eval": "localStorage.removeItem('gerard35.loadout.v1')"
    },
    {
      "teleport": "cardedeu",
      "cell": [
        170,
        193
      ]
    },
    {
      "eval": "window.gerard.storyEvent({ type: 'arrive', station: 'cardedeu' })"
    },
    {
      "shot": "arrive",
      "delay": 1500,
      "caption": "Out of the R4 at Cardedeu: «¿Esa no es Haru?»"
    },
    {
      "skipDialogue": true
    },
    {
      "teleport": "cardedeu",
      "cell": [
        167,
        190
      ]
    },
    {
      "shot": "haru",
      "delay": 1500,
      "caption": "Haru at the station's door: she looks back and leads the way"
    },
    {
      "skipDialogue": true
    },
    {
      "teleport": "cardedeu",
      "cell": [
        59,
        100
      ]
    },
    {
      "shot": "nuria-door",
      "delay": 1500,
      "caption": "Nuria at her door with Haru and Yuki"
    },
    {
      "press": "KeyE"
    },
    {
      "shot": "nuria-talks",
      "delay": 1200,
      "caption": "Nuria: Uri has gone strange, talking non-stop, and ran off round the corner with Nil"
    },
    {
      "skipDialogue": true
    },
    {
      "shot": "papagato-lent",
      "delay": 300,
      "caption": "ÁNIMA DESBLOQUEADA · Papagato: she lends them the cats"
    },
    {
      "hold": [
        "KeyW"
      ],
      "ms": 1500
    },
    {
      "shot": "cats-follow",
      "delay": 600,
      "caption": "Haru and Yuki walk with Gerard and Aitor"
    },
    {
      "teleport": "cardedeu",
      "cell": [
        63,
        65
      ]
    },
    {
      "press": "KeyE"
    },
    {
      "until": "document.title.includes('torre')",
      "timeout": 20000
    },
    {
      "shot": "tower-in",
      "delay": 2000,
      "caption": "Round the corner: a dark tower where there was none, and a ramp winding up round it"
    },
    {
      "skipDialogue": true
    },
    {
      "press": "KeyR"
    },
    {
      "shot": "tower-overview",
      "delay": 3000,
      "caption": "From above: the ramp rings round the tower, ring inside ring, up to the platform where El Vértigo stands"
    },
    {
      "press": "KeyR"
    },
    {
      "teleport": "cardedeu-laberinto",
      "cell": [
        12,
        49
      ]
    },
    {
      "shot": "ramp",
      "delay": 1800,
      "caption": "Up the first ring: walls always higher than you, violet lanterns, the haze"
    },
    {
      "teleport": "cardedeu-laberinto",
      "cell": [
        19,
        49
      ]
    },
    {
      "shot": "uri-ahead",
      "delay": 1500,
      "caption": "Uri ahead, Nil in his arms, violet eyes: «¡Nivel dos! ¡Más arriba!»"
    },
    {
      "skipDialogue": true
    },
    {
      "teleport": "cardedeu-laberinto",
      "cell": [
        49,
        34
      ]
    },
    {
      "shot": "spotted",
      "delay": 900,
      "caption": "El Cebollón has seen them: it runs, and the edges of the screen beat like a heart"
    },
    {
      "until": "document.querySelector('#battle .turn-meta')?.textContent === 'TU TURNO' || !!document.querySelector('#hud[data-dialogue]')",
      "timeout": 30000
    },
    {
      "shot": "caught",
      "delay": 300,
      "caption": "It caught them"
    },
    {
      "skipDialogue": true
    },
    {
      "until": "document.querySelector('#battle .turn-meta')?.textContent === 'TU TURNO' || !!document.querySelector('#hud[data-dialogue]')",
      "timeout": 30000
    },
    {
      "skipDialogue": true
    },
    {
      "until": "[...document.querySelectorAll('#battle .turn-meta')].some(e => e.textContent === 'TU TURNO') && document.querySelector('#battle').dataset.phase === 'player'",
      "timeout": 90000
    },
    {
      "shot": "cebollon",
      "delay": 1200,
      "caption": "El Cebollón: layer on layer, and everyone's eyes water"
    },
    {
      "eval": "document.querySelector('#battle [data-command=\"escape\"] .command-trigger').click()"
    },
    {
      "until": "!document.querySelector('#battle .battle-result')?.hidden",
      "timeout": 90000
    },
    {
      "eval": "document.querySelector('#battle .battle-result button').click()"
    },
    {
      "wait": 1500
    },
    {
      "eval": "window.gerard.story.nuria.stage = 3"
    },
    {
      "teleport": "cardedeu-laberinto",
      "cell": [
        27,
        31
      ]
    },
    {
      "wait": 600
    },
    {
      "shot": "summit",
      "delay": 600,
      "caption": "On top: El Vértigo, a giant of ladders five times their height, Uri and Nil at the very top"
    },
    {
      "skipDialogue": true
    },
    {
      "until": "[...document.querySelectorAll('#battle .turn-meta')].some(e => e.textContent === 'TU TURNO') && document.querySelector('#battle').dataset.phase === 'player'",
      "timeout": 90000
    },
    {
      "shot": "vertigo",
      "delay": 1500,
      "caption": "The fight: ALTURA in the heading, the spiral eye on its chest"
    },
    {
      "open": "/?story=clue-r4&solo=1"
    },
    {
      "until": "document.title.startsWith('Meridiana') && !document.querySelector('#hud[data-dialogue]')",
      "timeout": 60000
    },
    {
      "teleport": "cardedeu",
      "cell": [
        59,
        100
      ]
    },
    {
      "eval": "window.gerard.story.handle({ type: 'interact', id: 'talk-nuria' }); window.gerard.storyEvent({ type: 'battle', won: true, encounter: 'uri-vertigo', worn: ['papagato'] })"
    },
    {
      "skipDialogue": true
    },
    {
      "until": "document.title.startsWith('Cardedeu')",
      "timeout": 20000
    },
    {
      "skipDialogue": true
    },
    {
      "shot": "lights",
      "delay": 700,
      "caption": "The lights: Nuria flashes and a light rises out of her chest"
    },
    {
      "shot": "lights-flight",
      "delay": 900,
      "caption": "It arcs into Gerard; then Uri's into Aitor, and Nil's splits in two"
    },
    {
      "shot": "home",
      "delay": 5000,
      "caption": "Nuria, Uri and Nil together at the door; Uri's eyes are his own again"
    }
  ]
}
