    },
    {
      "skipDialogue": true
    },
    {
      "until": "document.title.startsWith('Cardedeu')",
      "timeout": 20000
    },
    {
      "skipDialogue": true
    },
    {
      "shot": "lights",
      "delay": 700,
      "caption": "The lights: Nuria flashes and a light rises out of her chest"
    },
    {
      "shot": "lights-flight",
      "delay": 900,
      "caption": "It arcs into Gerard; then Uri's into Aitor, and Nil's splits in two"
    },
    {
      "shot": "home",
      "delay": 5000,
      "caption": "Nuria, Uri and Nil together at the door; Uri's eyes are his own again"
    }
  ]
