{
  "title": "Songs and footsteps by place",
  "description": "docs/audio.md § Where music plays now and § Footsteps: the places that got a song (the house the game opens in and Alegia with triste, every friend's mission but Marta's on mazmorra-oscuro, the camping and Emilie's moved from mazmorra-2) next to one that had its song (the Meridiana), and the footstep each place asks for (STEPS in src/sfx.ts) as Gerard walks a few steps. The overlay is the scenario's: the song and its position, and the footsteps the game asked for since arriving. It plays music, so run it with --chrome: just screenshots place-sounds --chrome.",
  "steps": [
    {
      "open": "/?story=metro&solo=1"
    },
    {
      "skipDialogue": true
    },
    {
      "press": "Escape",
      "times": 2
    },
    {
      "eval": "navigator.getGamepads = () => []; window.showSound = () => { let el = document.querySelector('#music-check'); if (!el) { el = document.createElement('div'); el.id = 'music-check'; el.style.cssText = 'position:fixed;left:16px;bottom:16px;z-index:999;padding:8px 12px;border-radius:8px;background:#000c;color:#ffd6ec;font:14px/1.5 monospace;white-space:pre'; document.body.append(el); } const m = window.gerard.music, counts = {}; for (const id of window.steps) counts[id] = (counts[id] ?? 0) + 1; el.textContent = `♪ ${m.playing ?? 'silencio'} · ${m.position()?.toFixed(1) ?? '—'} s\\npasos: ${Object.entries(counts).map(([id, n]) => `${id} ×${n}`).join(', ') || '—'}`; }; window.steps = []; { const play = window.gerard.sfx.play; window.gerard.sfx.play = (id, options) => { if (String(id).startsWith('step')) window.steps.push(id); return play(id, options); }; } window.go = async id => { const { ENVIRONMENTS } = await import('/src/environments.ts'); window.steps.length = 0; window.gerard.game.setEnvironment(id, { ...ENVIRONMENTS[id].spawn }); };"
    },
    {
      "eval": "window.go('home-floor-2')"
    },
    {
      "until": "window.gerard.game && document.title.includes('·') && window.gerard.music.playing === 'triste' && window.gerard.music.position() > 1",
      "timeout": 60000
    },
    {
      "skipDialogue": true
    },
    {
      "hold": [
        "KeyD"
      ],
      "ms": 900
    },
    {
      "hold": [
        "KeyA"
      ],
      "ms": 900
    },
    {
      "hold": [
        "KeyW"
      ],
      "ms": 900
    },
    {
      "hold": [
        "KeyS"
      ],
      "ms": 900
    },
    {
      "until": "window.steps.includes('step-floor') && window.steps.every(id => id === 'step-floor')",
      "timeout": 5000
    },
    {
      "eval": "window.showSound()"
    },
    {
      "shot": "home-floor-2",
      "delay": 300,
      "caption": "The house where the game opens: triste, and steps on its floor"
    },
    {
      "eval": "window.go('maresme')"
    },
