{
  "title": "Chapter 1 · Block 1",
  "description": "Gerard's birthday morning: home, Mum's shoes, the backpack, Bernat, the stall, the déjà-vu, La Reina Bubbaloo's minion the first fight and the palace rising at the end of the street.",
  "steps": [
    {
      "open": "/?story=new"
    },
    {
      "until": "!document.querySelector('#story-card').hidden"
    },
    {
      "shot": "intro-card",
      "delay": 800,
      "caption": "Chapter card on the birthday morning"
    },
    {
      "until": "document.querySelector('#story-card').hidden",
      "timeout": 30000
    },
    {
      "shot": "wake-up",
      "delay": 500,
      "caption": "Gerard wakes up in his bedroom"
    },
    {
      "skipDialogue": true
    },
    {
      "shot": "bedroom",
      "caption": "Exploring the bedroom with no on-screen help"
    },
    {
      "teleport": "home-floor-2",
      "cell": [
        16,
        12
      ]
    },
    {
      "press": "KeyE"
    },
    {
      "shot": "jan",
      "delay": 1500,
      "caption": "Jan wishes him happy birthday"
    },
    {
      "skipDialogue": true
    },
    {
      "teleport": "home-floor-2",
      "cell": [
        17,
        11
      ]
    },
    {
      "shot": "potion-on-desk",
      "caption": "The potion floating over Jan's desk"
    },
    {
      "press": "KeyE"
    },
    {
      "skipDialogue": true
    },
    {
      "shot": "potion-taken",
      "caption": "First common item"
    },
    {
      "teleport": "home-floor-1",
      "cell": [
        2,
        1
      ]
    },
    {
      "press": "KeyE"
    },
    {
      "shot": "door-before-breakfast",
      "delay": 1200,
      "caption": "The front door waits for breakfast"
    },
    {
      "skipDialogue": true
    },
    {
      "teleport": "home-floor-1",
      "cell": [
        17,
        10
      ]
    },
    {
      "press": "KeyE"
    },
    {
      "shot": "mum",
      "delay": 1500,
      "caption": "Mum: Per molts anys!"
    },
    {
      "skipDialogue": true
    },
    {
      "shot": "shoes",
      "caption": "Running shoes, and the Shift hint"
    },
    {
      "teleport": "home-floor-1",
      "cell": [
        4,
        1
      ]
    },
    {
      "shot": "backpack-in-hall",
      "caption": "The backpack by the front door"
    },
    {
      "press": "KeyE"
    },
    {
      "skipDialogue": true
    },
    {
      "shot": "backpack-taken",
      "caption": "Key item, and the I hint"
    },
    {
      "press": "KeyI"
    },
    {
      "shot": "items-panel",
      "delay": 1500,
      "caption": "Objetos: common and key items"
    },
    {
      "press": "Escape"
    },
    {
      "teleport": "maresme",
      "cell": [
        9,
        24
      ]
    },
    {
      "press": "KeyE"
    },
    {
      "shot": "bernat-door",
      "delay": 1500,
      "caption": "Ringing Bernat's bell"
    },
    {
      "skipDialogue": true
    },
    {
      "shot": "bernat-joins",
      "caption": "Bernat joins, and the C hint"
    },
    {
      "press": "KeyC"
    },
    {
      "shot": "equipment",
      "delay": 1500,
      "caption": "Equipment per party member (modo escuela)"
    },
    {
      "press": "Escape"
    },
    {
      "teleport": "maresme",
      "cell": [
        15,
        28
      ]
    },
    {
      "hold": [
        "KeyS",
        "KeyA"
      ],
      "until": "window.gerard.story.companion === 'stalled'",
      "timeout": 90000
    },
    {
      "shot": "bernat-stalls",
      "caption": "Bernat stops and mutters over his head"
    },
    {
      "hold": [
        "KeyS",
        "KeyA"
      ],
      "until": "window.gerard.story.bubble === 'Esto… ya lo he visto.'",
      "timeout": 180000
    },
    {
      "shot": "leash",
      "caption": "Pulling away: his words escalate"
    },
    {
      "eval": "(() => { const b = window.gerard.game.companionPosition; window.gerard.game.setEnvironment('maresme', { x: Math.round(b.x), z: Math.round(b.z) + 1 }); })()"
    },
    {
      "until": "document.querySelector('#interact span').textContent.startsWith('Preguntarle')",
      "timeout": 20000
    },
    {
      "press": "KeyE"
    },
    {
      "shot": "dejavu",
      "delay": 1500,
      "caption": "Bernat: «esa cosa rosa que asoma detrás del coche»"
    },
    {
      "skipDialogue": true
    },
    {
      "wait": 1200
    },
    {
      "shot": "minion-rises",
      "caption": "A gum head rises through the manhole lid…"
    },
    {
      "wait": 1200
    },
    {
      "shot": "minion-bubble",
      "caption": "…blows a bubble and pops it over the dogs"
    },
    {
      "until": "!!document.querySelector('#hud[data-dialogue]')",
      "timeout": 30000
    },
    {
      "shot": "what-was-that",
      "delay": 1500,
      "caption": "«¡Ha salido algo rosa de la alcantarilla!» The dogs' eyes are pink"
    },
    {
      "skipDialogue": true
    },
    {
      "until": "!document.querySelector('#battle').hidden",
      "timeout": 30000
    },
    {
      "shot": "first-fight",
      "delay": 4000,
      "caption": "First fight, straight away: possessed dogs, no escape"
    },
    {
      "eval": "(async () => { const sleep = ms => new Promise(r => setTimeout(r, ms)); const b = document.querySelector('#battle'); for (let i = 0; i < 2000 && !b.hidden; i++) { if (!b.querySelector('.battle-result').hidden) return; const attack = b.querySelector('[data-command=\"attack\"] .command-trigger'); const target = b.querySelector('.battle-target[data-side=\"foes\"]:not(:disabled)'); if (target) target.click(); else if (!attack.disabled) attack.click(); await sleep(400); } })()"
    },
    {
      "until": "!document.querySelector('#battle .battle-result').hidden",
      "timeout": 900000
    },
    {
      "shot": "fight-won",
      "delay": 1000,
      "caption": "The pink leaves their eyes"
    },
    {
      "eval": "document.querySelector('#battle .battle-result button').click()"
    },
    {
      "wait": 2500
    },
    {
      "shot": "light-turns",
      "caption": "Back on the street: the light starts to turn"
    },
    {
      "until": "!!document.querySelector('#hud[data-dialogue]')",
      "timeout": 20000
    },
    {
      "wait": 4000
    },
    {
      "shot": "after-fight",
      "caption": "«¿Se ha puesto todo… rosa? Y oscuro.»"
    },
    {
      "skipDialogue": true
    },
    {
      "until": "!!window.gerard.game.app.root.findByName('Palacio de la Reina Bubbaloo')?.enabled",
      "timeout": 60000
    },
    {
      "wait": 3000
    },
    {
      "shot": "houses-change",
      "caption": "The houses at the north end start to change"
    },
    {
      "until": "!!document.querySelector('#hud[data-dialogue]')",
      "timeout": 240000
    },
    {
      "shot": "palace-rises",
      "delay": 1500,
      "caption": "«Es justo como en mi sueño… se está volviendo real.»"
    }
  ]
}
