{
  "title": "La Reina Bubbaloo: su escenario, Aitor de su lado y el final",
  "description": "docs/castle-bosses.md § La Reina Bubbaloo. Her entrance (src/throne-arena.ts THRONE_INTRO), her figure (Nuria Mendoza's face, src/monsters/reina.json) and portrait, her stage (src/throne-arena.ts), Aitor crossing to her side when she takes him and fighting from there with player 2's commands, the six notes bringing him back,. Run it with --gpu. Then her last scene, in the fight, for each choice: she sinks to the floor small, Gerard walks up and takes her by the neck, the two commands over it; Acabar charges the Foc Binari and she comes apart pink to grey, then the classroom over black; Bajar la mano lowers the hand and the dream ends in white; each to its Monday.",
  "steps": [
    {
      "open": "/?story=castle&solo=1"
    },
    {
      "until": "window.gerard && window.gerard.story.started",
      "timeout": 180000
    },
    {
      "wait": 1500
    },
    {
      "eval": "window.gerard.game.setEnvironment('palacio-trono', { x: 13, z: 9 }); setTimeout(() => window.gerard.storyEvent({ type: 'near', id: 'castillo-reina' }), 2500)"
    },
    {
      "until": "!!document.querySelector('#dialogue') && !document.querySelector('#dialogue').hidden && document.querySelector('#dialogue').textContent.includes('vint-i-cinc')",
      "timeout": 30000
    },
    {
      "shot": "habla",
      "delay": 900,
      "caption": "She speaks with Nuria Mendoza's face: her portrait in the conversation before the fight"
    },
    {
      "open": "/?story=castle&solo=1&fight=%7B%22adult%22%3Atrue%2C%22partner%22%3Atrue%2C%22wear%22%3A%7B%22gerard%22%3A%22matemagico%22%2C%22aitor%22%3A%22papagato%22%7D%2C%22animas%22%3A%5B%22matemagico%22%2C%22papagato%22%2C%22tecnopata%22%5D%2C%22friends%22%3A%5B%22nuria%22%2C%22universidad%22%2C%22marta%22%5D%2C%22encounter%22%3A%22reina-vuelta%22%2C%22foes%22%3A1%2C%22free%22%3Atrue%2C%22immune%22%3Atrue%7D"
    },
    {
      "until": "!!document.querySelector('#battle[data-intro-run]')",
      "timeout": 180000
    },
    {
      "shot": "entrada-candilejas",
      "delay": 1000,
      "caption": "Her entrance: the stage dark, the footlights coming on one by one as Gerard and Aitor walk on"
    },
    {
      "shot": "entrada-trono",
      "delay": 700,
      "caption": "Up the dark stage to her throne, her core beating in the bubble; she is a shape beside it"
    },
    {
      "until": "!!document.querySelector('#battle[data-intro-name]')",
      "timeout": 30000
    },
    {
      "shot": "entrada-nombre",
      "delay": 600,
      "caption": "The spotlight slams on: close on her from below, her crown lighting flavour by flavour, her name"
    },
    {
      "until": "!!document.querySelector('#battle[data-intro-pull]')",
      "timeout": 30000
    },
    {
      "shot": "entrada-vuelta",
      "delay": 1000,
      "caption": "The camera pulls back over their shoulders: she at the back of the stage, the bars opening"
    },
    {
      "until": "window.gerard && window.gerard.battleUI.fight && window.gerard.battleUI.fight.phase === 'player' && !window.gerard.battleUI.fight.busy && !document.querySelector('#battle[data-entering]')",
      "timeout": 180000
    },
    {
      "wait": 1500
    },
    {
      "shot": "escenario",
      "caption": "Her stage: the sala d'actes' boards with the footlights, the velvet, the banner, the balcony over the night city, and her throne (the bubble she blows, her core, the five flavours) with her gum spreading from it; her own figure in front"
    },
    {
      "eval": "window.gerard.battleUI.tweak(s => { window.bs = s; }); window.gerard.battleUI.jumpTo('reina-aitor')"
    },
    {
      "until": "window.bs.foes.find(f => f.kind === 'reina')?.castle?.stage === 'aitor' && !window.gerard.battleUI.fight.busy",
      "timeout": 30000
    },
    {
      "shot": "cruza",
      "delay": 700,
      "caption": "At her tenth she takes Aitor: he walks over to her side"
    },
    {
      "shot": "de-su-lado",
      "delay": 2600,
      "caption": "On her side, facing Gerard; his card has crossed too, in possession's violet, «Del lado de la Reina»"
    },
    {
      "eval": "window.gerard.battleUI.control('confirm'); setTimeout(() => window.gerard.battleUI.control('confirm'), 500)"
    },
    {
      "until": "!!document.querySelector('.held-menu')",
      "timeout": 30000
    },
    {
      "shot": "su-turno",
      "delay": 800,
      "caption": "Her turn is his: player 2 picks what Aitor does to Gerard"
    },
    {
      "eval": "document.querySelector('.held-menu [data-held=\"0\"]').click()"
    },
    {
      "shot": "golpe",
      "delay": 650,
      "caption": "He runs at Gerard from her side, as a foe would, and goes back to stand by her"
    },
    {
      "until": "window.gerard.battleUI.fight.phase === 'player' && !window.gerard.battleUI.fight.busy",
      "timeout": 30000
    },
    {
      "eval": "[0, 4, 5, 7, 3, 2].forEach((n, i) => setTimeout(() => window.gerard.battleUI.note(n), 300 + i * 450))"
    },
    {
      "shot": "vuelve",
      "delay": 3300,
      "caption": "The six notes: the thread breaks and Aitor walks back to Gerard, his card back in the party"
    },
    {
      "eval": "window.gerard.battleUI.jumpTo('won')"
    },
    {
      "until": "document.querySelector('#battle')?.dataset.finale === 'true'",
      "timeout": 20000
    },
    {
      "shot": "acabar-en-el-suelo",
      "delay": 1300,
      "caption": "At 0 she does not come apart: she sinks to the floor, small, and Gerard walks up to her; the fight's HUD has gone"
    },
    {
      "until": "!document.querySelector('#ending')?.hidden && document.querySelector('#ending')?.dataset.on === 'true'",
      "timeout": 30000
    },
    {
      "shot": "acabar-cuello",
      "delay": 1800,
      "caption": "Close on the two of them: his hand at her neck, and his two commands"
    },
    {
      "eval": "document.querySelector('#ending button[data-choice=\"acabar\"]').focus(); undefined"
    },
    {
      "eval": "document.querySelector('#ending button[data-choice=\"acabar\"]').click()"
    },
    {
      "until": "!!document.querySelector('.battle-speech-line')",
      "timeout": 10000
    },
    {
      "shot": "acabar-carga",
      "delay": 1500,
      "caption": "Acabar: Aitor's «Hazlo.» as the Foc Binari forms in the hand at her neck"
    },
    {
      "shot": "acabar-se-deshace",
      "delay": 2300,
      "caption": "It goes into her and she comes apart, pink to grey"
    },
    {
      "until": "!document.querySelector('#ending').hidden && document.querySelector('#ending').dataset.black === 'true' && document.querySelector('#ending').dataset.on === 'true'",
      "timeout": 30000
    },
    {
      "shot": "acabar-escena",
      "delay": 1800,
      "caption": "Over black: where the throne was, a classroom"
    },
    {
      "wait": 1000
    },
    {
      "eval": "document.querySelector('#ending').click()"
    },
    {
      "until": "!!document.querySelector('#dialogue') && !document.querySelector('#dialogue').hidden && document.querySelector('#dialogue').textContent.includes('Dilluns')",
      "timeout": 120000
    },
    {
      "shot": "acabar-lunes",
      "delay": 1500,
      "caption": "The Monday after: the alarm at its hour"
    },
    {
      "open": "/?story=castle&solo=1&fight=%7B%22adult%22%3Atrue%2C%22partner%22%3Atrue%2C%22wear%22%3A%7B%22gerard%22%3A%22matemagico%22%2C%22aitor%22%3A%22papagato%22%7D%2C%22animas%22%3A%5B%22matemagico%22%2C%22papagato%22%2C%22tecnopata%22%5D%2C%22friends%22%3A%5B%22nuria%22%2C%22universidad%22%2C%22marta%22%5D%2C%22encounter%22%3A%22reina-vuelta%22%2C%22foes%22%3A1%2C%22free%22%3Atrue%2C%22immune%22%3Atrue%7D"
    },
    {
      "until": "window.gerard && window.gerard.battleUI.fight && window.gerard.battleUI.fight.phase === 'player' && !window.gerard.battleUI.fight.busy && !document.querySelector('#battle[data-entering]')",
      "timeout": 180000
    },
    {
      "wait": 1500
    },
    {
      "eval": "window.gerard.battleUI.jumpTo('won')"
    },
    {
      "until": "document.querySelector('#battle')?.dataset.finale === 'true'",
      "timeout": 20000
    },
    {
      "shot": "bajar-en-el-suelo",
      "delay": 1300,
      "caption": "At 0 she does not come apart: she sinks to the floor, small, and Gerard walks up to her; the fight's HUD has gone"
    },
    {
      "until": "!document.querySelector('#ending')?.hidden && document.querySelector('#ending')?.dataset.on === 'true'",
      "timeout": 30000
    },
    {
      "shot": "bajar-cuello",
      "delay": 1800,
      "caption": "Close on the two of them: his hand at her neck, and his two commands"
    },
    {
      "eval": "document.querySelector('#ending button[data-choice=\"bajar\"]').focus(); undefined"
    },
    {
      "eval": "document.querySelector('#ending button[data-choice=\"bajar\"]').click()"
    },
    {
      "until": "!!document.querySelector('.battle-speech-line')",
      "timeout": 10000
    },
    {
      "shot": "bajar-suelta",
      "delay": 900,
      "caption": "Bajar la mano: «…Vale. Vale.» as his hand comes down from her neck"
    },
    {
      "until": "document.querySelector('#queen-scream')?.dataset.on === 'true'",
      "timeout": 20000
    },
    {
      "shot": "bajar-blanco",
      "delay": 1800,
      "caption": "The dream ends, in white"
    },
    {
      "until": "!!document.querySelector('#dialogue') && !document.querySelector('#dialogue').hidden && document.querySelector('#dialogue').textContent.includes('Dilluns')",
      "timeout": 120000
    },
    {
      "shot": "bajar-lunes",
      "delay": 1500,
      "caption": "The Monday after: the alarm at its hour"
    }
  ]
}
