      "timeout": 120000
    },
    {
      "wait": 1500
    },
    {
      "shot": "luca-gris",
      "delay": 900,
      "caption": "Luca on the pond's north bank, grey, clear of the trees, facing the Nativity facade; in the water, his reflection still in colour (stand-in figure)"
    },
    {
      "press": "KeyE"
    },
    {
      "shot": "luca-habla",
      "delay": 900,
      "caption": "The first time: he fades each time he crosses the door"
    },
    {
      "skipDialogue": true
    },
    {
      "wait": 1600
    },
    {
      "teleport": "sagrada-familia",
      "cell": [
        76,
        158
      ],
      "settle": 900
