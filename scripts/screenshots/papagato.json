{
  "title": "Papagato · Haru and Yuki in a fight",
  "description": "Nuria's ánima (docs/animas/papagato/): Gerard wears Papagato and the cats sit beside him, Haru ahead and Yuki behind. Zarpazo de Haru sends Haru at a foe and leaves Sangrado stacks under its nameplate; the cushion-soft orange interface with MIAU in the corner.",
  "steps": [
    { "open": "/?story=papagato&solo=1" },
    { "until": "document.title.startsWith('Meridiana') && !document.querySelector('#hud[data-dialogue]')", "timeout": 60000 },
    { "eval": "localStorage.removeItem('gerard35.loadout.v1')" },
    { "wait": 1000 },
    { "press": "KeyC" },
    { "press": "KeyE", "gap": 600 },
    { "eval": "document.querySelector('[data-wear=\"gerard\"][data-class-id=\"papagato\"]').click(); document.querySelector('[data-wear=\"aitor\"][data-class-id=\"noista\"]').click();" },
    { "shot": "status-papagato", "delay": 1200, "caption": "The Ánimas page: Gerard wears Papagato, with Zarpazo de Haru and Yuki se esconde" },
    { "press": "Escape" },
    { "eval": "window.gerard.battleUI.open(window.gerard.story.battleParty(true), 2, { animas: window.gerard.story.classes })" },
    { "until": "document.querySelector('#battle .turn-meta')?.textContent === 'TU TURNO'", "timeout": 60000 },
    { "shot": "battle-cats", "delay": 1500, "caption": "Haru a step ahead of Gerard, Yuki a step behind, and the Papagato interface" },
    { "until": "document.querySelector('.battle-dock[data-dock=\"1\"]')?.dataset.member === 'gerard'", "timeout": 20000 },
    { "press": "Digit2" },
    { "shot": "battle-papagato-skills", "delay": 1200, "caption": "Papagato's skills: Zarpazo de Haru and Yuki se esconde" },
    { "press": "Digit1", "gap": 400 },
    { "press": "Enter", "gap": 300 },
    { "shot": "battle-zarpazo", "delay": 450, "caption": "Zarpazo de Haru: Haru pounces on the dog" },
    { "shot": "battle-sangrado", "delay": 1800, "caption": "Sangrado 2 under the dog's nameplate" }
  ]
}
