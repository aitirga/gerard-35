#!/usr/bin/env python3
"""How far the game is, from docs/progress.toml, measured against the checkout.

Usage:
  scripts/herdr-progress [--dir PATH]            the panel at the top of herdr's column; q quits, r rereads
  scripts/herdr-progress --once [--all] [--dir PATH]   print it once (just progress)
  scripts/herdr-progress --audit [--dir PATH]    what the bar rests on, checks that cannot tick, and
                                                 whether the game is wired together (just progress --audit)

herdr-layout runs this in any project that has it. The checks read a few named files, so it
looks again every few seconds and draws only when something changed. See docs/dev-tools.md.
"""
import argparse
import glob
import os
import re
import select
import shutil
import signal
import subprocess
import sys
import termios
import time
import tomllib
import tty
from pathlib import Path

REFRESH = 5
CHECK_KEYS = {"done", "file", "grep", "absent", "in", "used"}
# Where the game's code lives: a `used` name is looked for here, and a `file` in here must be imported.
SOURCES = "src/**/*.ts"
ITEM_KEYS = CHECK_KEYS | {"title", "weight", "priority"}
EIGHTHS = " ▏▎▍▌▋▊▉"
# Her pink at the start, then Papagato's orange, Matemágico's gold and a calm sage at the end.
GRADIENT = ((255, 111, 174), (240, 149, 74), (243, 207, 120), (140, 198, 168))
TRACK = (52, 50, 64)


def load(path):
    """The manifest, refusing a mistyped key: it would read as work not done, for ever."""
    with open(path, "rb") as handle:
        manifest = tomllib.load(handle)
    known = {p["id"] for p in manifest.get("priority", [])}
    for block in manifest.get("block", []):
        for item in block.get("item", []):
            name = item.get("title", "?")
            if unknown := set(item) - ITEM_KEYS:
                raise ValueError(f"{name}: no conozco {', '.join(sorted(unknown))}")
            if ("grep" in item or "absent" in item) and "in" not in item:
                raise ValueError(f"{name}: grep y absent necesitan in")
            if "in" in item and "grep" not in item and "absent" not in item:
                raise ValueError(f"{name}: in sin grep ni absent")
            if "priority" in item and item["priority"] not in known:
                raise ValueError(f"{name}: no hay prioridad {item['priority']}")
    return manifest


def names(value):
    return [value] if isinstance(value, str) else list(value)


IMPORT = re.compile(r"""['"]\.{1,2}/((?:[\w.-]+/)*)([\w.-]+?|\*)(?:\.ts)?['"]""")


def checks_of(item, root, read, game):
    """Each check the item has and whether it holds: (kind, holds). `game` knows what the code imports and uses."""
    checks = []
    if "file" in item:
        found = glob.glob(item["file"], root_dir=root, recursive=True)
        # A module that exists and nothing imports is written, not in the game.
        code = [path for path in found if path.startswith("src/") and path.endswith(".ts")]
        checks.append(("file", bool(found) and (not code or any(game.imported(path) for path in code))))
    if "grep" in item:
        checks.append(("grep", any(re.search(item["grep"], text, re.MULTILINE) for text in read(item["in"]))))
    if "absent" in item:
        texts = read(item["in"])
        checks.append(("absent", bool(texts) and not any(re.search(item["absent"], text, re.MULTILINE) for text in texts)))
    if "used" in item:
        # Defined in one module and used in another: in the game, not only written.
        checks.append(("used", all(game.modules(name) >= 2 for name in names(item["used"]))))
    return checks


def is_done(item, checks):
    """A manual `done` wins; otherwise every check it has must hold, and one with none is pending."""
    if "done" in item:
        return bool(item["done"])
    return bool(checks) and all(holds for _, holds in checks)


class Game:
    """The game's code, read only if a check asks: who imports what, which names are where."""

    def __init__(self, root, read):
        self.root, self.read, self.sources, self.counts, self.links = root, read, None, {}, None

    def texts(self):
        if self.sources is None:
            paths = sorted(glob.glob(SOURCES, root_dir=self.root, recursive=True))
            self.sources = {path: text for path in paths for text in self.read(path)}
        return self.sources

    def modules(self, name):
        """In how many modules the name is, as a whole word."""
        if name not in self.counts:
            word = re.compile(rf"(?<![\w$]){re.escape(name)}(?![\w$])")
            self.counts[name] = sum(name in text and bool(word.search(text)) for text in self.texts().values())
        return self.counts[name]

    def imported(self, path):
        """Whether something brings this module in: another by name or its whole folder at once, or a page of its own."""
        if self.links is None:
            # Every relative import of every module: (the module it is in, the folder it names, the name).
            self.links = [(source, folders.rstrip("/").rsplit("/", 1)[-1], stem)
                          for source, text in self.texts().items() for folders, stem in IMPORT.findall(text)]
            self.pages = self.read("*.html")
        stem, folder = Path(path).stem, Path(path).parent.name
        return any(path in page for page in self.pages) or any(
            source != path and (name == stem or (name == "*" and inside == folder)) for source, inside, name in self.links)


# The panel measures every few seconds: the code is read again only when one of its files changed.
_games = {}


def game_of(root, read):
    stamp = tuple((path, stat.st_mtime_ns, stat.st_size) for path in sorted(glob.glob(SOURCES, root_dir=root, recursive=True) + glob.glob("*.html", root_dir=root))
                  for stat in [os.stat(os.path.join(root, path))])
    if _games.get(root, (None,))[0] != stamp:
        _games[root] = (stamp, Game(root, read))
    return _games[root][1]


def share(items):
    total = sum(i.get("weight", 1) for i in items)
    return sum(i.get("weight", 1) for i in items if i["ok"]) / total if total else 0


def weighted(blocks, key):
    blocks = [b for b in blocks if b.get(key)]
    total = sum(b[key] for b in blocks)
    return sum(b[key] * b["share"] for b in blocks) / total if total else 0


def measure(manifest, root):
    """Every item ticked or not, each block's share, the total and the priorities."""
    cache = {}

    def read(patterns):
        patterns = [patterns] if isinstance(patterns, str) else patterns
        paths = sorted({p for pattern in patterns for p in glob.glob(pattern, root_dir=root, recursive=True)})
        texts = []
        for path in paths:
            if path not in cache:
                try:
                    cache[path] = Path(root, path).read_text(errors="replace")
                except OSError:
                    cache[path] = None
            if cache[path] is not None:
                texts.append(cache[path])
        return texts

    game = game_of(root, read)
    blocks = []
    for block in manifest.get("block", []):
        items = []
        for item in block.get("item", []):
            checks = checks_of(item, root, read, game)
            items.append({**item, "ok": is_done(item, checks), "checks": checks,
                          "found": {key: bool(read(item[key]) if key == "in" else glob.glob(item[key], root_dir=root, recursive=True)) for key in ("in", "file") if key in item},
                          "defined": {name: game.modules(name) for name in names(item.get("used", []))}})
        blocks.append({**block, "item": items, "share": share(items)})
    every = [item for block in blocks for item in block["item"]]
    priorities = []
    for priority in manifest.get("priority", []):
        items = [i for i in every if i.get("priority") == priority["id"]]
        pending = [i for i in items if not i["ok"]]
        priorities.append({"title": priority["title"], "items": items, "pending": pending, "share": share(items)})
    return {"blocks": blocks, "total": weighted(blocks, "weight"), "story": weighted(blocks, "story"), "priorities": priorities}


def percent(value):
    """Rounded, but never 100 % before everything is done."""
    return 100 if value >= 1 else min(99, round(value * 100))


def gradient(position):
    position = min(max(position, 0), 1) * (len(GRADIENT) - 1)
    low = min(int(position), len(GRADIENT) - 2)
    return tuple(round(a + (b - a) * (position - low)) for a, b in zip(GRADIENT[low], GRADIENT[low + 1]))


def bar(value, width, colour):
    """A bar in eighths of a cell, coloured by how far along each cell is, so reaching the far end turns it calm."""
    cells = value * width
    full, partial = int(cells), int((cells - int(cells)) * 8)
    if not colour:
        return "█" * full + "░" * (width - full)
    out = []
    for cell in range(width):
        r, g, b = gradient(cell / max(width - 1, 1))
        if cell < full:
            out.append(f"\033[38;2;{r};{g};{b}m█")
        else:
            glyph = EIGHTHS[partial] if cell == full else " "
            out.append(f"\033[38;2;{r};{g};{b}m\033[48;2;{TRACK[0]};{TRACK[1]};{TRACK[2]}m{glyph}\033[49m")
    return "".join(out) + "\033[0m"


def fit(text, width):
    return text if len(text) <= width else text[: max(width - 1, 0)] + "…"


def row(label, value, right, width, colour):
    """`label ▕bar▏ right`, the label taking what the bar and the number leave."""
    bar_width = max(min(width // 3, 18), 4)
    room = max(width - bar_width - len(right) - 2, 1)
    return f"{fit(label, room):<{room}} {bar(value, bar_width, colour)} {right}"


def render(data, heading, rows, cols, colour, error=None):
    """The panel's lines for this size: the bar always, then what fits, most useful first."""
    bold, dim, reset = ("\033[1m", "\033[2m", "\033[0m") if colour else ("", "", "")
    width = max(cols - 2, 10)
    if data is None:
        return [f" {fit(error or 'Leyendo…', width)}"]
    total = f"{percent(data['total'])} %"
    room = max(width - len(total) - 1, 1)
    lines = [f" {bold}{fit(heading, room):<{room}} {total}{reset}"]
    lines += [f" {bar(data['total'], width, colour)}"] * (2 if rows >= 9 else 1)
    lines.append(f" {dim}Historia jugable {percent(data['story'])} %{reset}")
    if error:
        lines.append(f" {fit(error, width)}")

    priorities = []
    current = True
    for index, priority in enumerate(data["priorities"], 1):
        done, count = len(priority["items"]) - len(priority["pending"]), len(priority["items"])
        if priority["pending"]:
            mark, style = ("▸" if current else " "), (bold if current else "")
            tally = f"{done}/{count}"
            room = max(width - len(tally) - 5, 1)
            priorities.append(f" {style}{mark} {index} {fit(priority['title'], room):<{room}}{reset} {dim}{tally}{reset}")
            if current and rows >= 13:
                priorities.append(f" {dim}    {fit('sigue: ' + priority['pending'][0]['title'], width - 4)}{reset}")
            current = False
        else:
            priorities.append(f" {dim}✓ {index} {fit(priority['title'], width - 4)}{reset}")
    if priorities and rows - len(lines) >= 3:
        lines += ["", f" {bold}PRIORIDADES{reset}"] + priorities

    left = rows - len(lines) - 2
    # Without room for them all, the finished ones go first.
    shown = data["blocks"] if left >= len(data["blocks"]) else [b for b in data["blocks"] if b["share"] < 1]
    if shown and left >= 1:
        lines += ["", f" {bold}BLOQUES{reset}"]
        lines += [f" {row(b['title'], b['share'], f'{percent(b["share"]):>3} %', width, colour)}" for b in shown[:left]]
    return lines[: max(rows, 1)]


EVIDENCE = (("used", "conectado: definido en un módulo y usado en otro"), ("text", "un texto en un archivo"),
            ("file", "existe un archivo (y el juego lo importa, si es código)"), ("hand", "marcado a mano"))


def evidence(item):
    """What a ticked item rests on, the strongest of its checks."""
    kinds = {kind for kind, _ in item["checks"]}
    return "hand" if "done" in item else "used" if "used" in kinds else "text" if kinds & {"grep", "absent"} else "file"


def audit(data):
    """The list's own health: what cannot tick as written (`broken`), and what the bar rests on."""
    broken, seen = [], set()
    total = sum(block.get("weight", 0) for block in data["blocks"]) or 1
    rests = {kind: [0.0, 0] for kind, _ in EVIDENCE}
    waiting = []
    for block in data["blocks"]:
        inside = sum(item.get("weight", 1) for item in block["item"]) or 1
        for item in block["item"]:
            title = item["title"]
            if title in seen:
                broken.append(f"«{title}»: está dos veces")
            seen.add(title)
            if "in" in item and not item["found"]["in"]:
                broken.append(f"«{title}»: `in` no encuentra ningún archivo ({item['in']})")
            for name, files in item["defined"].items():
                if not files:
                    broken.append(f"«{title}»: `used` busca {name}, que no está en {SOURCES}")
            failing = [kind for kind, holds in item["checks"] if not holds]
            if item.get("done") and failing:
                broken.append(f"«{title}»: marcado a mano, pero su comprobación ({', '.join(failing)}) no se cumple")
            if item["ok"]:
                rest = rests[evidence(item)]
                rest[0] += block.get("weight", 0) / total * item.get("weight", 1) / inside
                rest[1] += 1
            elif not item["checks"]:
                waiting.append(title)
    return {"broken": broken, "rests": rests, "waiting": waiting}


def print_audit(data, colour):
    bold, dim, reset = ("\033[1m", "\033[2m", "\033[0m") if colour else ("", "", "")
    report = audit(data)
    print(f" {bold}AUDITORÍA DEL PROGRESO{reset} {dim}(docs/progress.toml){reset}")
    if report["broken"]:
        print(f"\n ✗ Comprobaciones rotas: {len(report['broken'])} por arreglar")
        for line in report["broken"]:
            print(f"     ✗ {line}")
    else:
        print("\n ✓ Comprobaciones: todas pueden cumplirse y ninguna se contradice")
    print(f"\n {bold}En qué se apoya el {percent(data['total'])} %{reset}")
    for kind, label in EVIDENCE:
        points, count = report["rests"][kind]
        print(f"   {points * 100:5.1f} puntos · {count:3} elementos · {label}")
    print(f"\n · Pendientes que solo se marcan a mano: {len(report['waiting'])}")
    for title in report["waiting"]:
        print(f"     · {title}")
    return not report["broken"]


def integration(root):
    """The game's own registries against each other (scripts/integration.mjs); False if something is broken."""
    script = Path(root, "scripts/integration.mjs")
    if not script.exists() or not shutil.which("node"):
        print("\n · Integración: hace falta node y scripts/integration.mjs")
        return True
    print(flush=True)
    return subprocess.run(["node", "--experimental-strip-types", "--no-warnings", str(script)], cwd=root, check=False).returncode == 0


def manifest_path(root):
    """This checkout's list, or for a worktree from before it had one, the list beside this script."""
    own = Path(root, "docs/progress.toml")
    return own if own.exists() else Path(__file__).resolve().parents[1] / "docs/progress.toml"


def heading_of(root, head):
    """`gerard-35 · feat/x`, from the checkout's HEAD file: no process every few seconds."""
    name = Path(root).name
    try:
        text = Path(head).read_text().strip()
    except (OSError, TypeError):
        return name
    project = re.sub(r"-(feat|feature|bugfix|fix|hotfix|docs|refactor|chore|test|perf)-.*$", "", name)
    branch = text.removeprefix("ref: refs/heads/") if text.startswith("ref:") else text[:8]
    return f"{project} · {branch}"


def head_path(root):
    found = subprocess.run(["git", "-C", root, "rev-parse", "--path-format=absolute", "--git-path", "HEAD"],
                           capture_output=True, text=True, check=False)
    return found.stdout.strip() if found.returncode == 0 else None


def once(root, every, colour):
    data = measure(load(manifest_path(root)), root)
    size = shutil.get_terminal_size((72, 40))
    for line in render(data, heading_of(root, head_path(root)), 200, min(size.columns, 100), colour):
        print(line)
    if every:
        for block in data["blocks"]:
            print(f"\n {block['title']} ({percent(block['share'])} %)")
            for item in block["item"]:
                print(f"   {'✓' if item['ok'] else '·'} {item['title']}")


def watch(root, colour):
    def stop(*_):
        raise SystemExit
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGHUP, stop)
    stdin = sys.stdin.fileno()
    saved = termios.tcgetattr(stdin)
    head = head_path(root)
    data, error, shown, due = None, None, None, 0.0
    tty.setcbreak(stdin)
    sys.stdout.write("\033[?1049h\033[?25l")
    try:
        while True:
            if time.monotonic() >= due:
                due = time.monotonic() + REFRESH
                try:
                    data, error = measure(load(manifest_path(root)), root), None
                except (OSError, ValueError, re.error) as problem:  # Half-saved: keep the last good numbers.
                    error = f"docs/progress.toml: {problem}"
            size = shutil.get_terminal_size((72, 24))
            frame = render(data, heading_of(root, head), size.lines, size.columns, colour, error)
            if frame != shown:
                sys.stdout.write("\033[H" + "\033[K\n".join(frame) + "\033[K\033[J")
                sys.stdout.flush()
                shown = frame
            if select.select([stdin], [], [], 1)[0]:
                key = os.read(stdin, 16)
                if not key or key in (b"q", b"Q", b"\x03"):
                    return
                if key in (b"r", b"R"):
                    due = 0.0
    finally:
        sys.stdout.write("\033[?25h\033[?1049l")
        sys.stdout.flush()
        termios.tcsetattr(stdin, termios.TCSADRAIN, saved)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--dir", default=".", help="the checkout to measure")
    parser.add_argument("--once", action="store_true", help="print it once and leave")
    parser.add_argument("--all", action="store_true", help="with --once, every item")
    parser.add_argument("--audit", action="store_true", help="the list's health and the game's integration; fails if something is broken")
    args = parser.parse_args()
    root = os.path.abspath(args.dir)
    colour = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
    if args.audit:
        healthy = print_audit(measure(load(manifest_path(root)), root), colour)
        wired = integration(root)
        raise SystemExit(0 if healthy and wired else 1)
    if args.once or not sys.stdin.isatty():
        once(root, args.all, colour)
    else:
        watch(root, colour)


if __name__ == "__main__":
    main()
